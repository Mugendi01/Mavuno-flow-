// Prisma schema for MavunoFlow
// Default local datasource is SQLite for immediate out-of-the-box development & testing.
// For PostgreSQL production deployment, see prisma/schema.postgresql.prisma or switch provider to "postgresql".

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  fullName            String
  phoneNumber         String?
  emailVerified       DateTime?
  onboardingCompleted Boolean            @default(false)
  memberships         FarmMember[]
  createdTransactions Transaction[]      @relation("CreatedTransactions")
  deletedTransactions Transaction[]      @relation("DeletedTransactions")
  recordedPayments    Payment[]
  reportPreferences   ReportPreference[]
  auditLogs           AuditLog[]
  recordedFeedRecords       FeedRecord[]        @relation("RecordedFeedRecords")
  recordedProductionRecords ProductionRecord[]  @relation("RecordedProductionRecords")
  createdFeedPurchases      FeedPurchase[]      @relation("CreatedFeedPurchases")
  recordedStockMovements    FeedStockMovement[] @relation("RecordedStockMovements")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([email])
}

model Farm {
  id                  String             @id @default(uuid())
  name                String
  slug                String             @unique
  locationCounty      String
  subCounty           String?
  townArea            String?
  country             String             @default("Kenya")
  currency            String             @default("KES")
  farmSizeAcres       Float?
  timezone            String             @default("Africa/Nairobi")
  primaryEnterpriseId String?
  recordKeepingMethod String?
  trackedPriorities   String?
  scaleOperationsJson String?
  members             FarmMember[]
  enterprises         Enterprise[]
  categories          Category[]
  transactions        Transaction[]
  receivables         Receivable[]
  weeklyReports       WeeklyReport[]
  reportPreferences   ReportPreference[]
  receipts            Receipt[]
  auditLogs           AuditLog[]
  livestockGroups     LivestockGroup[]
  feedRecords         FeedRecord[]
  productionRecords   ProductionRecord[]
  feedProducts        FeedProduct[]
  feedPurchases       FeedPurchase[]
  feedStockMovements  FeedStockMovement[]
  feedAlerts          FeedAlert[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([slug])
}

model FarmMember {
  id       String   @id @default(uuid())
  farmId   String
  farm     Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("OWNER") // OWNER | MANAGER | FARM_HAND
  joinedAt DateTime @default(now())

  @@unique([farmId, userId])
  @@index([userId])
  @@index([farmId])
}

model EnterpriseType {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique // POULTRY | AQUACULTURE | PIGGERY | GOATS_SHEEP | CATTLE | CROPS
  icon        String
  enterprises Enterprise[]
  categories  Category[]
}

model Enterprise {
  id               String         @id @default(uuid())
  farmId           String
  farm             Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  enterpriseTypeId String
  enterpriseType   EnterpriseType @relation(fields: [enterpriseTypeId], references: [id])
  name             String
  status           String         @default("ACTIVE") // ACTIVE | INACTIVE | ARCHIVED
  transactions     Transaction[]
  livestockGroups  LivestockGroup[]
  feedRecords      FeedRecord[]
  productionRecords ProductionRecord[]
  feedProducts     FeedProduct[]
  feedPurchases    FeedPurchase[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([farmId])
  @@index([enterpriseTypeId])
}

model Category {
  id               String          @id @default(uuid())
  farmId           String?
  farm             Farm?           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  enterpriseTypeId String?
  enterpriseType   EnterpriseType? @relation(fields: [enterpriseTypeId], references: [id], onDelete: SetNull)
  name             String
  type             String // EXPENSE | INCOME
  isSystem         Boolean         @default(false)
  transactions     Transaction[]
  createdAt        DateTime        @default(now())

  @@index([farmId])
  @@index([type])
}

model Transaction {
  id              String      @id @default(uuid())
  localId         String      @unique // Client UUID idempotency key for offline sync
  farmId          String
  farm            Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  enterpriseId    String
  enterprise      Enterprise  @relation(fields: [enterpriseId], references: [id])
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  createdById     String
  createdBy       User        @relation("CreatedTransactions", fields: [createdById], references: [id])
  type            String // EXPENSE | SALE
  transactionDate DateTime
  amount          Float
  quantity        Float?
  unit            String?
  unitPrice       Float?
  paymentMethod   String      @default("CASH") // CASH | MPESA | BANK | CREDIT | OTHER
  paymentStatus   String      @default("PAID") // PAID | PARTIALLY_PAID | CREDIT
  salesChannel    String?
  buyerName       String?
  notes           String?
  receiptUrl      String?
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  deletedById     String?
  deletedBy       User?       @relation("DeletedTransactions", fields: [deletedById], references: [id])
  receivable      Receivable?
  receipt         Receipt?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([farmId, transactionDate])
  @@index([farmId, enterpriseId])
  @@index([farmId, type])
  @@index([localId])
}

model Receivable {
  id            String    @id @default(uuid())
  farmId        String
  farm          Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  transactionId String    @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String?
  totalAmount   Float
  paidAmount    Float     @default(0)
  balanceAmount Float
  dueDate       DateTime?
  status        String    @default("PENDING") // PENDING | PARTIALLY_PAID | PAID | OVERDUE
  payments      Payment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([farmId, status])
}

model Payment {
  id            String     @id @default(uuid())
  receivableId  String
  receivable    Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  amount        Float
  paymentDate   DateTime   @default(now())
  paymentMethod String     @default("MPESA") // CASH | MPESA | BANK | OTHER
  referenceCode String?    // e.g. M-Pesa transaction code
  recordedById  String
  recordedBy    User       @relation(fields: [recordedById], references: [id])
  notes         String?
  createdAt     DateTime   @default(now())

  @@index([receivableId])
}

model WeeklyReport {
  id                     String    @id @default(uuid())
  farmId                 String
  farm                   Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  weekStartDate          DateTime
  weekEndDate            DateTime
  totalRevenue           Float
  totalExpenses          Float
  netProfit              Float
  cashReceived           Float
  cashSpent              Float
  outstandingReceivables Float
  reportDataJson         String // JSON serialized breakdown
  pdfUrl                 String?
  status                 String    @default("GENERATED") // GENERATED | SENT | FAILED
  sentAt                 DateTime?
  createdAt              DateTime  @default(now())

  @@index([farmId, weekStartDate])
}

model ReportPreference {
  id           String   @id @default(uuid())
  farmId       String
  farm         Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isEnabled    Boolean  @default(true)
  dayOfWeek    Int      @default(1) // 1 = Monday
  timeOfDay    String   @default("07:00")
  emailAddress String
  timezone     String   @default("Africa/Nairobi")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([farmId, userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  farmId     String
  farm       Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  action     String // CREATE | UPDATE | DELETE | VOID
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  oldValues  String?  // JSON string
  newValues  String?  // JSON string
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([farmId, entityType, entityId])
}

model Receipt {
  id                String       @id @default(uuid())
  transactionId     String       @unique
  transaction       Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  farmId            String
  farm              Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  receiptNumber     String       @unique // e.g. "FP-20260922-000184"
  verificationToken String       @unique
  qrPayload         String       // Public verification URL
  status            String       @default("VALID") // VALID | VOIDED
  issuedAt          DateTime     @default(now())
  voidedAt          DateTime?
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([farmId])
  @@index([receiptNumber])
  @@index([verificationToken])
}

model LivestockGroup {
  id                String             @id @default(uuid())
  farmId            String
  farm              Farm               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  enterpriseId      String
  enterprise        Enterprise         @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  name              String             // e.g. "Flock A - Isa Brown Layers", "Pen 2 - Broilers Batch 4", "Milking Herd Alpha"
  species           String             // POULTRY | DAIRY_CATTLE | BEEF_CATTLE | GOATS | SHEEP | PIGS | RABBITS | OTHER
  breed             String?            // e.g. "Isa Brown", "Friesian", "Boer", "Landrace"
  productionStage   String?            // e.g. "Laying", "Brooding", "Lactating", "Dry", "Finishing", "Fattening", "Weaning", "Breeding"
  initialCount      Int                @default(0)
  currentCount      Int                @default(0)
  startDate         DateTime           @default(now())
  status            String             @default("ACTIVE") // ACTIVE | SOLD | ARCHIVED | COMPLETED
  notes             String?
  feedRecords       FeedRecord[]
  productionRecords ProductionRecord[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([farmId, status])
  @@index([enterpriseId])
  @@index([species])
}

model FeedRecord {
  id                 String              @id @default(uuid())
  farmId             String
  farm               Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  enterpriseId       String
  enterprise         Enterprise          @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  livestockGroupId   String?
  livestockGroup     LivestockGroup?     @relation(fields: [livestockGroupId], references: [id], onDelete: SetNull)
  feedProductId      String?
  feedProduct        FeedProduct?        @relation(fields: [feedProductId], references: [id], onDelete: SetNull)
  recordedById       String
  recordedBy         User                @relation("RecordedFeedRecords", fields: [recordedById], references: [id])
  date               DateTime            @default(now())
  feedType           String              // e.g. "Layers Mash", "Broiler Starter", "Dairy Meal", "Hay / Boma Rhodes"
  quantityIssued     Float
  unit               String              // "kg" | "g" | "litres" | "bags" | "bales"
  bagWeightKg        Float?              // weight per bag in kg if unit is bags
  quantityIssuedKg   Float               // normalized to kilograms
  quantityConsumed   Float?              // actual feed consumed if measured
  quantityConsumedKg Float?              // normalized consumed kg
  quantityWasted     Float?              // remaining or wasted feed
  feedCost           Float?              // cost in KES
  notes              String?
  stockMovements     FeedStockMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([farmId, date])
  @@index([enterpriseId])
  @@index([livestockGroupId])
  @@index([feedProductId])
}

model ProductionRecord {
  id                String          @id @default(uuid())
  farmId            String
  farm              Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  enterpriseId      String
  enterprise        Enterprise      @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  livestockGroupId  String?
  livestockGroup    LivestockGroup? @relation(fields: [livestockGroupId], references: [id], onDelete: SetNull)
  recordedById      String
  recordedBy        User            @relation("RecordedProductionRecords", fields: [recordedById], references: [id])
  date              DateTime        @default(now())
  metric            String          // EGGS | MILK | WEIGHT | BIRTHS | WEANED | MORTALITY | OTHER
  quantity          Float           // Main measure (eggs, litres, kg live weight, heads)
  unit              String          // "pieces" | "trays" | "litres" | "kg" | "head"
  secondaryQuantity Float?          // e.g. damaged eggs, rejected milk, mortality count
  qualityGrade      String?         // "Grade A", "Large", "Medium", "High Butterfat", etc.
  quantitySold      Float?
  quantityFarmUse   Float?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([farmId, date])
  @@index([enterpriseId])
  @@index([livestockGroupId])
  @@index([metric])
}

model FeedProduct {
  id                   String              @id @default(uuid())
  farmId               String
  farm                 Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  enterpriseId         String?
  enterprise           Enterprise?         @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  name                 String              // e.g. "Layers Complete Mash (70kg)"
  feedType             String              // e.g. "Layers Mash", "Broiler Starter", "Dairy Meal", "Hay / Boma Rhodes"
  intendedUse          String?             // e.g. "Laying hens 18+ weeks"
  storageLocation      String?             @default("Main Feed Store")
  defaultUnit          String              @default("kg")
  defaultBagWeightKg   Float?              @default(50)
  currentStockKg       Float               @default(0)
  unitCost             Float?              @default(0) // Weighted average cost per kg (KES/kg)
  minReserveKg         Float               @default(100)
  criticalReserveKg    Float               @default(30)
  reorderQuantityKg    Float?
  leadTimeDays         Int?                @default(3)
  reminderPeriodDays   Int?                @default(2)
  expectedDailyUsageKg Float?
  status               String              @default("ACTIVE") // ACTIVE | ARCHIVED
  purchases            FeedPurchase[]
  feedRecords          FeedRecord[]
  stockMovements       FeedStockMovement[]
  alerts               FeedAlert[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([farmId, status])
  @@index([farmId, feedType])
  @@index([enterpriseId])
}

model FeedPurchase {
  id                 String              @id @default(uuid())
  farmId             String
  farm               Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  feedProductId      String
  feedProduct        FeedProduct         @relation(fields: [feedProductId], references: [id], onDelete: Cascade)
  enterpriseId       String?
  enterprise         Enterprise?         @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  purchaseDate       DateTime            @default(now())
  supplierName       String              // e.g. "Unga Farm Care", "Kenchic Agrovet"
  quantity           Float
  unit               String              // "bags" | "kg" | "bales" | "tonnes" | "g"
  bagWeightKg        Float?
  quantityKg         Float               // Normalized kilograms
  unitPrice          Float               // Price per unit purchased
  totalCost          Float               // quantity * unitPrice
  paymentMethod      String              @default("MPESA") // CASH | MPESA | BANK | CREDIT
  paymentStatus      String              @default("PAID") // PAID | CREDIT | PARTIALLY_PAID
  invoiceRef         String?
  batchNumber        String?
  expiryDate         DateTime?
  storageLocation    String?
  status             String              @default("RECEIVED") // DRAFT | RECEIVED | CANCELLED
  receivedAt         DateTime?
  receivedQuantityKg Float?
  transactionId      String?
  createdById        String
  createdBy          User                @relation("CreatedFeedPurchases", fields: [createdById], references: [id])
  notes              String?
  stockMovements     FeedStockMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([farmId, purchaseDate])
  @@index([feedProductId])
  @@index([status])
}

model FeedStockMovement {
  id               String        @id @default(uuid())
  farmId           String
  farm             Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  feedProductId    String
  feedProduct      FeedProduct   @relation(fields: [feedProductId], references: [id], onDelete: Cascade)
  movementType     String        // PURCHASE_RECEIPT | FEED_ISSUE | RETURN_TO_STOCK | WASTAGE_LOSS | MANUAL_ADJUSTMENT | PURCHASE_REVERSAL
  quantityKg       Float         // Positive for additions, negative for deductions
  previousStockKg  Float
  resultingStockKg Float
  feedPurchaseId   String?
  feedPurchase     FeedPurchase? @relation(fields: [feedPurchaseId], references: [id], onDelete: SetNull)
  feedRecordId     String?
  feedRecord       FeedRecord?   @relation(fields: [feedRecordId], references: [id], onDelete: SetNull)
  unitCost         Float?        // Cost per kg at movement
  totalValue       Float?
  storageLocation  String?
  createdById      String
  createdBy        User          @relation("RecordedStockMovements", fields: [createdById], references: [id])
  reason           String?
  createdAt        DateTime      @default(now())

  @@index([farmId, createdAt])
  @@index([feedProductId])
  @@index([movementType])
  @@index([feedPurchaseId])
  @@index([feedRecordId])
}

model FeedAlert {
  id             String      @id @default(uuid())
  farmId         String
  farm           Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  feedProductId  String
  feedProduct    FeedProduct @relation(fields: [feedProductId], references: [id], onDelete: Cascade)
  alertType      String      // LOW_STOCK | CRITICAL_STOCK | OUT_OF_STOCK | REPLENISHMENT_REMINDER
  severity       String      // INFO | WARNING | CRITICAL
  message        String
  currentStockKg Float
  thresholdKg    Float?
  daysRemaining  Float?
  status         String      @default("ACTIVE") // ACTIVE | ACKNOWLEDGED | RESOLVED
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([farmId, status])
  @@index([feedProductId])
  @@index([alertType])
}


